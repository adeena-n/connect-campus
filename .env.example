# ==============================================================================
# CampusConnect — Unified Environment Configuration Example
# ==============================================================================

# --- AI Studio / Standalone Server Port ---
PORT=3000

# --- Frontend Client Variables (VITE_ prefix is exposed to browser) ---
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Backend Serverless / Server Variables (Server-side ONLY, NEVER expose to browser) ---
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Optional: Password for seeded evaluator accounts (evaluator.owner@campus.edu & evaluator.applicant@campus.edu)
EVALUATOR_PASSWORD="Evaluator2026!"

# Optional: Secret admin key to protect maintenance endpoints (e.g. POST /api/seed/reset) in production
ADMIN_KEY="your-secret-admin-key"
